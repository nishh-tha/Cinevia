# Copy to server/.env and fill in. NEVER commit .env.

# --- Server ---
PORT=3000
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# --- MySQL (Aiven) ---
DB_HOST=mysql-3b97caf0-seatbooking-database.b.aivencloud.com
DB_PORT=26245
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
# Aiven requires SSL. The CA certificate stays at server/certs/ca.pem (path relative to server/)
DB_SSL=true
DB_SSL_CA_PATH=certs/ca.pem

# --- Redis (seat holds) ---
# docker compose up -d redis   ->  host port 9000
REDIS_URL=redis://localhost:9000

# --- Auth ---
# At least 32 characters. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=2h

# --- Booking rules (optional) ---
SEAT_HOLD_SECONDS=300
MAX_SEATS_PER_BOOKING=8
CONVENIENCE_FEE_PAISE=3000
APP_TIMEZONE=Asia/Kolkata
